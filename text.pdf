import { useState } from "react";

const problems = [
  {
    id: 1,
    type: "UI",
    difficulty: "Easy",
    title: "Toggle Button",
    description: "Create a button that toggles between 'ON' and 'OFF' states, changing its background color accordingly.",
    code: `import { useState } from "react";

function ToggleButton() {
  const [isOn, setIsOn] = useState(false);

  return (
    <button
      onClick={() => setIsOn(!isOn)}
      style={{
        padding: "10px 24px",
        borderRadius: "6px",
        border: "none",
        cursor: "pointer",
        backgroundColor: isOn ? "#22c55e" : "#ef4444",
        color: "white",
        fontSize: "16px",
        fontWeight: "bold",
        transition: "background-color 0.3s"
      }}
    >
      {isOn ? "ON" : "OFF"}
    </button>
  );
}

export default ToggleButton;`,
    concepts: ["useState", "Event Handling", "Conditional Rendering"],
    explanation: "We use useState to track the toggle state. The onClick handler flips the boolean value. Conditional rendering is used for label and backgroundColor.",
  },
  {
    id: 2,
    type: "Coding",
    difficulty: "Easy",
    title: "Counter with Min/Max",
    description: "Build a counter with increment and decrement buttons. The counter should not go below 0 or above 10.",
    code: `import { useState } from "react";

function Counter() {
  const [count, setCount] = useState(0);

  const increment = () => setCount(prev => Math.min(prev + 1, 10));
  const decrement = () => setCount(prev => Math.max(prev - 1, 0));

  return (
    <div>
      <button onClick={decrement} disabled={count === 0}>-</button>
      <span style={{ margin: "0 16px", fontSize: "24px" }}>{count}</span>
      <button onClick={increment} disabled={count === 10}>+</button>
    </div>
  );
}

export default Counter;`,
    concepts: ["useState", "Functional Updates", "Disabled State"],
    explanation: "Math.min and Math.max enforce boundaries. We use functional updates (prev =>) to ensure we always operate on the latest state. The disabled prop prevents out-of-range clicks.",
  },
  {
    id: 3,
    type: "UI",
    difficulty: "Easy",
    title: "Controlled Form Input",
    description: "Create a controlled input field that displays the typed text in real-time below the input.",
    code: `import { useState } from "react";

function LiveInput() {
  const [text, setText] = useState("");

  return (
    <div>
      <input
        type="text"
        value={text}
        onChange={(e) => setText(e.target.value)}
        placeholder="Type something..."
        style={{ padding: "8px", fontSize: "16px", width: "300px" }}
      />
      <p>Live: <strong>{text || "(empty)"}</strong></p>
    </div>
  );
}

export default LiveInput;`,
    concepts: ["Controlled Components", "onChange", "useState"],
    explanation: "In a controlled input, React state is the single source of truth. value={text} makes input controlled, onChange updates state on every keystroke keeping UI in sync.",
  },
  {
    id: 4,
    type: "Scenario",
    difficulty: "Easy",
    title: "Todo List",
    description: "Build a simple Todo List where users can add new tasks and mark tasks as complete by clicking on them.",
    code: `import { useState } from "react";

function TodoList() {
  const [todos, setTodos] = useState([]);
  const [input, setInput] = useState("");

  const addTodo = () => {
    if (!input.trim()) return;
    setTodos([...todos, { id: Date.now(), text: input, done: false }]);
    setInput("");
  };

  const toggleTodo = (id) => {
    setTodos(todos.map(todo =>
      todo.id === id ? { ...todo, done: !todo.done } : todo
    ));
  };

  return (
    <div>
      <input value={input} onChange={e => setInput(e.target.value)} placeholder="Add task..." />
      <button onClick={addTodo}>Add</button>
      <ul>
        {todos.map(todo => (
          <li key={todo.id}
            onClick={() => toggleTodo(todo.id)}
            style={{ textDecoration: todo.done ? "line-through" : "none", cursor: "pointer" }}>
            {todo.text}
          </li>
        ))}
      </ul>
    </div>
  );
}

export default TodoList;`,
    concepts: ["useState", "Array Immutability", "List Rendering", "key prop"],
    explanation: "Each todo has a unique id (Date.now()). We use .map() to toggle a specific todo immutably by spreading and updating only the matching id. The key prop helps React reconcile the list efficiently.",
  },
  {
    id: 5,
    type: "Coding",
    difficulty: "Medium",
    title: "useEffect – Fetch Data",
    description: "Fetch and display a list of users from a public API when the component mounts. Show a loading state while fetching.",
    code: `import { useState, useEffect } from "react";

function UserList() {
  const [users, setUsers] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetch("https://jsonplaceholder.typicode.com/users")
      .then(res => res.json())
      .then(data => {
        setUsers(data);
        setLoading(false);
      });
  }, []); // Empty array = run once on mount

  if (loading) return <p>Loading...</p>;

  return (
    <ul>
      {users.map(user => (
        <li key={user.id}>{user.name} – {user.email}</li>
      ))}
    </ul>
  );
}

export default UserList;`,
    concepts: ["useEffect", "Dependency Array", "Async Data Fetching", "Loading State"],
    explanation: "useEffect with an empty dependency array [] runs only on mount — equivalent to componentDidMount. We track loading state separately to conditionally render a spinner or the data.",
  },
  {
    id: 6,
    type: "Scenario",
    difficulty: "Medium",
    title: "Search Filter",
    description: "Given a list of country names, render a search input that filters the list in real-time as the user types.",
    code: `import { useState } from "react";

const countries = ["India", "USA", "Germany", "France", "Japan", "Brazil", "Canada", "Australia"];

function SearchFilter() {
  const [query, setQuery] = useState("");

  const filtered = countries.filter(c =>
    c.toLowerCase().includes(query.toLowerCase())
  );

  return (
    <div>
      <input
        value={query}
        onChange={e => setQuery(e.target.value)}
        placeholder="Search country..."
      />
      <ul>
        {filtered.length > 0
          ? filtered.map(c => <li key={c}>{c}</li>)
          : <li>No results found</li>}
      </ul>
    </div>
  );
}

export default SearchFilter;`,
    concepts: ["Derived State", "Array.filter", "Controlled Input"],
    explanation: "The filtered list is derived from state — no need for a separate state for it. Case-insensitive matching with .toLowerCase() ensures better UX. This is the 'single source of truth' principle.",
  },
